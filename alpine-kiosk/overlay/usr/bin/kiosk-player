#!/bin/sh
# CLI control tool for Raspberry Pi 3 Video Kiosk

case "$1" in
    start)
        /etc/init.d/kiosk-player start
        ;;
    stop)
        /etc/init.d/kiosk-player stop
        killall -9 mpv 2>/dev/null || true
        ;;
    restart)
        /etc/init.d/kiosk-player stop
        killall -9 mpv 2>/dev/null || true
        /etc/init.d/kiosk-player start
        ;;
    status)
        echo "=== Kiosk Player Service Status ==="
        /etc/init.d/kiosk-player status
        echo ""
        echo "=== Active Processes ==="
        ps aux | grep -E 'kiosk-player|mpv' | grep -v grep || echo "No active processes found."
        echo "=== Active Media Location ==="
        if [ -d "/run/kiosk-videos" ] && [ -n "$(ls -A /run/kiosk-videos 2>/dev/null)" ]; then
            echo "Status: Running from IN-RAM tmpfs (SD card unmounted and safely ejectable!)"
        else
            echo "Status: Streaming from physical storage"
        fi
        echo ""
        echo "=== Active Playlist ==="
        if [ -f "/run/kiosk-playlist.txt" ]; then
            cat -n /run/kiosk-playlist.txt
        else
            echo "No active playlist file found."
        fi
        echo ""
        echo "=== MPV Recent Log (/run/kiosk-mpv.log) ==="
        if [ -f "/run/kiosk-mpv.log" ]; then
            tail -n 12 /run/kiosk-mpv.log
        else
            echo "No MPV log file found."
        fi
        echo ""
        echo "=== Display Orientation ==="
        echo "Orientation: $(cat /run/kiosk-orientation 2>/dev/null || echo 0) deg"
        echo ""
        echo "=== Free RAM ==="
        free -h
        ;;
    log)
        if [ -f "/run/kiosk-mpv.log" ]; then
            tail -n 50 /run/kiosk-mpv.log
        else
            echo "No MPV log file found at /run/kiosk-mpv.log"
        fi
        ;;
    rotate|orientation)
        if [ -n "$2" ]; then
            case "$2" in
                90|portrait|right) ROT=90 ;;
                180|inverted|flip|upside-down) ROT=180 ;;
                270|portrait-inverted|left) ROT=270 ;;
                0|landscape|normal|*) ROT=0 ;;
            esac
            echo "$ROT" > /run/kiosk-orientation
            if [ -d /media/mmcblk0p1 ]; then
                echo "$ROT" > /media/mmcblk0p1/orientation.txt 2>/dev/null || true
            fi
            echo "Display orientation set to: ${ROT} deg"
            echo "Restarting kiosk-player..."
            /etc/init.d/kiosk-player restart
        else
            echo "Current orientation: $(cat /run/kiosk-orientation 2>/dev/null || echo 0) deg"
            echo "Usage: kiosk-player rotate {0|90|180|270|landscape|portrait}"
        fi
        ;;
    *)
        echo "Usage: kiosk-player {start|stop|restart|status|log|rotate [0|90|180|270]}"
        exit 1
        ;;
esac
