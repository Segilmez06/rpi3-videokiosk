# /etc/inittab - Alpine Linux Video Kiosk configuration
::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default

# Physical Serial UART Console on Raspberry Pi 3 (GPIO 14/15, Pins 8/10/6)
# Instant unprompted root shell at 115200 baud with xterm-256color
ttyAMA0::respawn:/sbin/getty -L 115200 ttyAMA0 xterm-256color -n -l /bin/sh

# Virtual consoles
tty1::respawn:/sbin/getty 38400 tty1

# System shutdown actions
::shutdown:/sbin/openrc shutdown
